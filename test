                    Size = UDim2.new(1, 0, 0, targetH)
                }):Play()
            end)
            
            return {
                Set = function(val)
                    selected = val
                    SelectedLbl.Text = tostring(selected)
                    refreshOptions()
                    pcall(callback, selected)
                end,
                SetOptions = function(newOpts)
                    options = newOpts
                    refreshOptions()
                end,
                Get = function() return selected end
            }
        end
        
