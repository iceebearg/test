        --// 3. Slider Component
        function TabAPI:AddSlider(cfg)
            local sTitle = cfg.Title or "Slider"
            local sDesc = cfg.Desc or ""
            local min = cfg.Min or 0
            local max = cfg.Max or 100
            local def = math.clamp(cfg.Default or min, min, max)
            local suffix = cfg.Suffix or ""
            local precision = cfg.Precision or 0
            local callback = cfg.Callback or function() end
            
            local val = def
            
            local Card = UI.New("Frame", {
                Size = UDim2.new(1, 0, 0, 54),
                BackgroundColor3 = Color3.fromRGB(22, 24, 30),
                BorderSizePixel = 0,
                Parent = TabPage
            })
            UI.New("UICorner", { CornerRadius = UDim.new(0, 8), Parent = Card })
            UI.New("UIStroke", { Color = Color3.fromRGB(38, 42, 52), Thickness = 1, Parent = Card })
            addMetallicGradient(Card, 90, Color3.fromRGB(28, 30, 38), Color3.fromRGB(20, 21, 27))
            
            local TopRow = UI.New("Frame", {
                Size = UDim2.new(1, -24, 0, 20),
                Position = UDim2.new(0, 12, 0, 6),
                BackgroundTransparency = 1,
                Parent = Card
            })
            UI.New("TextLabel", {
                Size = UDim2.new(1, -60, 1, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamSemibold,
                Text = sTitle,
                TextColor3 = Color3.fromRGB(245, 245, 255),
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = TopRow
            })
            local ValLbl = UI.New("TextLabel", {
                Size = UDim2.new(0, 60, 1, 0),
                Position = UDim2.new(1, -60, 0, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold,
                Text = tostring(val) .. suffix,
                TextColor3 = Color3.fromRGB(255, 255, 255),
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = TopRow
            })
            
            local SliderTrack = UI.New("Frame", {
                Size = UDim2.new(1, -24, 0, 8),
                Position = UDim2.new(0, 12, 0, 34),
                BackgroundColor3 = Color3.fromRGB(36, 39, 50),
                BorderSizePixel = 0,
                Parent = Card
            })
            UI.New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = SliderTrack })
            
            local FillPct = (val - min) / (max - min)
            local SliderFill = UI.New("Frame", {
                Size = UDim2.new(FillPct, 0, 1, 0),
                BackgroundColor3 = Color3.fromRGB(245, 245, 250),
                BorderSizePixel = 0,
                Parent = SliderTrack
            })
            UI.New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = SliderFill })
            addMetallicGradient(SliderFill, 90, Color3.fromRGB(255, 255, 255), Color3.fromRGB(180, 185, 200))
            
            local SliderBtn = UI.New("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                Parent = SliderTrack
            })
            
            local sliding = false
            local function updateSlider(input)
                local trackAbs = SliderTrack.AbsolutePosition.X
                local trackSize = SliderTrack.AbsoluteSize.X
                local mouseX = input.Position.X
                local pct = math.clamp((mouseX - trackAbs) / trackSize, 0, 1)
                
                local rawVal = min + (max - min) * pct
                if precision == 0 then
                    val = math.floor(rawVal + 0.5)
                else
                    val = math.floor(rawVal * (10 ^ precision) + 0.5) / (10 ^ precision)
                end
                
                SliderFill.Size = UDim2.new(pct, 0, 1, 0)
                ValLbl.Text = tostring(val) .. suffix
                pcall(callback, val)
            end
            
            SliderBtn.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    updateSlider(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)
            
            return {
                Set = function(newVal)
                    val = math.clamp(newVal, min, max)
                    local pct = (val - min) / (max - min)
                    SliderFill.Size = UDim2.new(pct, 0, 1, 0)
                    ValLbl.Text = tostring(val) .. suffix
                    pcall(callback, val)
                end,
                Get = function() return val end
            }
        end
        
