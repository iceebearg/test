function Icons.Apply(imgLabel, iconName)
    local data = Icons.Registry[iconName] or Icons.Registry["sparkles"]
    imgLabel.Image = "rbxassetid://" .. data.Id
    imgLabel.ImageRectSize = data.Size
    imgLabel.ImageRectOffset = data.Offset
    imgLabel.ScaleType = Enum.ScaleType.Fit
end

--// Declarative UI Builder (Inspired by Cobalt's Interface.New)
local UI = {}

function UI.New(className, props)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do
        if typeof(k) == "number" and typeof(v) == "Instance" then
            v:Clone().Parent = obj
        elseif typeof(v) == "table" and not (k == "Color" or k == "Transparency" or k == "Keypoints") then
            local child = UI.New(k, v)
            child.Parent = obj
        else
            pcall(function() obj[k] = v end)
        end
    end
    return obj
end

local function addMetallicGradient(parent, rot, c1, c2, c3)
    local grad = Instance.new("UIGradient")
    grad.Rotation = rot or 45
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, c1 or Color3.fromRGB(36, 38, 46)),
        ColorSequenceKeypoint.new(0.5, c2 or Color3.fromRGB(24, 25, 30)),
        ColorSequenceKeypoint.new(1, c3 or c1 or Color3.fromRGB(18, 19, 23))
    })
    grad.Parent = parent
    return grad
end

local function applyBounce(btn, baseW, baseH)
    btn.AnchorPoint = Vector2.new(0.5, 0.5)
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, baseW - 3, 0, baseH - 3)
        }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, baseW, 0, baseH)
        }):Play()
    end)
end

